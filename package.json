{
  "name": "d-asst",
  "version": "0.1.0",
  "private": true,
  "author": "D-Asst",
  "description": "D-Asst — Windows AI task and time management app",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env D_ASST_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable --config.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.dasst.desktop",
    "productName": "D-Asst",
    "asar": true,
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "signAndEditExecutable": false, "target": [{ "target": "portable", "arch": ["x64"] }] },
    "portable": { "artifactName": "D-Asst-${version}-portable.exe" }
  }
}
